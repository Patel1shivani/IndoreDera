# Indore Dera API — environment
# Ise copy karke ".env" banayein: cp .env.example .env

NODE_ENV=development
PORT=4000

# MongoDB. Local mongod ke liye niche wali line, Atlas ke liye apna SRV URI daalein:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/indoredera?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/indoredera

# JWT signing key — production me ise zaroor badlein (lamba random string).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# Kaunse frontends is API ko call kar sakte hain (comma se alag).
CORS_ORIGINS=http://localhost:8080,http://localhost:5174,http://localhost:5173,http://localhost:3000

# Startup par default content (hero, banners, plans, seed listings) aur demo admin
# bana dein agar database khaali ho. Production me "false" rakhein.
SEED_ON_START=true

# Demo admin — sirf tab banta hai jab database me koi admin na ho.
# Production me ye credentials kabhi mat rakhein.
ADMIN_NAME=Indore Dera Admin
ADMIN_EMAIL=admin@indoredera.in
ADMIN_PHONE=9826000001
ADMIN_PASSWORD=admin123
